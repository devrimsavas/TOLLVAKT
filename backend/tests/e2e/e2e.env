# Settings for the API in the web app's end-to-end tests (no secrets).
# Read instead of .env when the tests start the API; a variable already set
# in the environment wins, e.g. DATABASE_URL in CI.
PORT=3100
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tollvakt_e2e
JWT_SECRET=e2e-only-secret-not-used-anywhere-else
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@e2e.example.com
ADMIN_PASSWORD=AdminE2eSecure2026
ADMIN_FIRST_NAME=Ada
ADMIN_LAST_NAME=Admin
# The models are the fakes in fakeServices.mjs: no network, same answers
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
# Daily quotas: low, so the tests can use them up. The tests clear the
# usage between them through the control server.
GUEST_DAILY_LIMIT=1
USER_DAILY_LIMIT=3
GLOBAL_DAILY_LIMIT=100000
E2E_CONTROL_PORT=3199
# Rate limits: the tests register many users from one address
REGISTRATIONS_PER_ADDRESS=1000
LOGIN_FAILURES_PER_ADDRESS=1000
LOGIN_FAILURES_PER_ACCOUNT=1000
REQUESTS_PER_ADDRESS=100000
PASSWORD_RESETS_PER_ACCOUNT=1000
PASSWORD_RESETS_PER_ADDRESS=1000
PASSWORD_CHECK_FAILURES_PER_ACCOUNT=1000
# Emails are kept by fakeServices.mjs; the links point at the web app the
# tests run
EMAIL_PROVIDER=log
WEB_APP_URL=http://localhost:3101
# Only warnings and errors, so the test output stays readable
LOG_LEVEL=warn
