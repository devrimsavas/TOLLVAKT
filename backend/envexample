PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/tollvakt

# Sessions. Make a long random secret, e.g. with: openssl rand -hex 32
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# The admin account, created on startup if no admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Logs: "json" writes one JSON object per line (the default, for servers);
# "pretty" writes readable, coloured lines (for development, needs the dev
# dependencies). LOG_LEVEL is the lowest level written: trace, debug, info,
# warn, error, fatal or silent.
LOG_FORMAT=pretty
LOG_LEVEL=info

# Rate limits (the defaults are shown). Failed logins are counted per account
# and per address in 15 minutes, new accounts per address in an hour, and all
# API requests per address in 15 minutes.
LOGIN_FAILURES_PER_ACCOUNT=10
LOGIN_FAILURES_PER_ADDRESS=30
REGISTRATIONS_PER_ADDRESS=10
REQUESTS_PER_ADDRESS=1500
# Proxies whose X-Forwarded-For is trusted for the client's address. The default
# trusts this machine and private networks (the web app, Docker).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Semantic search. The query vector must come from the same model as the
# stored tariff vectors, so these must match etl/.env. Locally Ollama
# (ollama pull embeddinggemma), in production the Gemini API (a key from
# Google AI Studio). Without them, search with mode=semantic answers 503.
EMBEDDING_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Language model: rewrites searches into the tariff's wording (search
# mode=expanded) and later chooses codes. Locally Ollama (ollama pull
# gemma4:12b), in production the Gemini API. Without them, mode=expanded
# answers 503.
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=gemma4:12b
GEMINI_LLM_MODEL=
# GEMINI_THINKING_LEVEL=low
# LLM_TIMEOUT_SECONDS=60
# Context window Ollama gives the model, in tokens (Ollama's own default,
# 4096, is too small for classification)
# OLLAMA_NUM_CTX=16384
