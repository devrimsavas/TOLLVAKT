# Copy to .env.local and adjust. Read only by the Next server, never sent
# to the browser.

# Where the Tollvakt API (the Express backend) runs
API_URL=http://localhost:3000

# The header a hosting platform puts the visitor's address in, sent on to the
# API for its rate limits and the guests' daily quota: x-real-ip on Vercel,
# cf-connecting-ip behind Cloudflare. Empty: the first address in
# X-Forwarded-For.
CLIENT_IP_HEADER=

# GoatCounter, which counts page views without cookies or personal data:
# the counter's address from its script (data-goatcounter). Empty: nothing
# is counted, as in development. Query strings are never sent and the ids
# of saved classifications in paths are counted as :id.
GOATCOUNTER_URL=
